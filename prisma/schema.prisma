generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────
// Auth
// ──────────────────────────────

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  emailVerified   Boolean  @default(false)
  username        String   @unique
  displayUsername String?
  name            String?
  image           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Auth related
  role       String    @default("user")
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?
  sessions   Session[]
  accounts   Account[]

  // Profile
  bio     String?
  country String?

  // User album, track and comments.
  ratings         Rating[]
  trackRatings    TrackRating[]
  comments        Comment[]
  favoriteAlbums  UserFavoriteAlbum[]
  favoriteArtists UserFavoriteArtist[]

  // Follow graph
  following Follow[] @relation("Following")
  followers Follow[] @relation("Followers")

  // Notifications
  notificationsReceived Notification[] @relation("NotificationsReceived")
  notificationsSent     Notification[] @relation("NotificationsSent")

  // Rotation streak — consecutive rotations where the user rated every
  // album before it closed. lastCompletedRotationId is both the
  // consecutiveness check (compare against the rotation immediately
  // before it) and an idempotency guard against double-incrementing.
  rotationStreak          Int       @default(0)
  longestRotationStreak   Int       @default(0)
  lastCompletedRotationId String?
  lastCompletedRotation   Rotation? @relation(fields: [lastCompletedRotationId], references: [id], onDelete: SetNull)

  @@map("user")
}


model UserFavoriteAlbum {
  // Max 10 per user — enforced in application code, not the schema.
  id       String @id @default(cuid())
  position Int // display order, e.g. 1–5 or 1–10

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  albumId String
  album   Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, albumId])
  @@unique([userId, position])
  @@index([albumId])
}

model UserFavoriteArtist {
  // Max 10 per user — enforced in application code, not the schema.
  id       String @id @default(cuid())
  position Int

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  artistId String
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, artistId])
  @@unique([userId, position])
  @@index([artistId])
}

model Session {
  id             String   @id @default(cuid())
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
  @@index([identifier])
}

// ──────────────────────────────
// Enums
// ──────────────────────────────

enum StreamingPlatform {
  SPOTIFY
  APPLE_MUSIC
  DEEZER
  TIDAL
  YOUTUBE_MUSIC
  SOUNDCLOUD
  BANDCAMP
  AMAZON_MUSIC
  OTHER
}

enum ReleaseType {
  LP
  EP
  SINGLE
  COMPILATION
  LIVE
  MIXTAPE
  SOUNDTRACK
}

enum ArtistRole {
  PRIMARY
  FEATURED
  PRODUCER
}

enum NotificationType {
  NEW_FOLLOWER
  ROTATION_OPENING
  ROTATION_CLOSING_SOON
  ROTATION_CLOSED
  NEW_COMMENT
}

// ──────────────────────────────
// Core content
// ──────────────────────────────

model Artist {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  image         String?
  bio           String?
  country       String? // ISO 3166-1 alpha-2, e.g. "US", "JP"
  debutDate     DateTime?
  disbandedDate DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  genres         ArtistGenre[]
  albums         AlbumArtist[]
  streamingLinks StreamingLink[]
  favoritedBy    UserFavoriteArtist[]
}

model Label {
  id      String  @id @default(cuid())
  name    String
  slug    String  @unique
  country String? // ISO 3166-1 alpha-2

  albums Album[]
}

model Album {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  coverImage  String?
  releaseDate DateTime?
  releaseType ReleaseType  @default(LP)
  genres      AlbumGenre[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  averageRating Float?
  ratingCount   Int    @default(0)

  labelId String?
  label   Label?  @relation(fields: [labelId], references: [id], onDelete: SetNull)

  artists        AlbumArtist[]
  tracks         Track[]
  ratings        Rating[]
  streamingLinks StreamingLink[]
  rotations      RotationAlbum[]
  favoritedBy    UserFavoriteAlbum[]

  // Notifications that reference this album (e.g. a comment on one of
  // its ratings). Cascades — if the album goes, so do its notifications.
  notifications Notification[]

  @@index([labelId])
}

model Track {
  id        String   @id @default(cuid())
  title     String
  number    Int?
  createdAt DateTime @default(now())

  albumId String
  album   Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)

  ratings TrackRating[]

  @@index([albumId])
}

model AlbumArtist {
  album    Album      @relation(fields: [albumId], references: [id], onDelete: Cascade)
  albumId  String
  artist   Artist     @relation(fields: [artistId], references: [id], onDelete: Cascade)
  artistId String
  role     ArtistRole @default(PRIMARY)

  @@id([albumId, artistId])
  @@index([artistId])
}

// ──────────────────────────────
// Ratings & comments
// ──────────────────────────────

model Rating {
  id        String   @id @default(cuid())
  score     Float? // average across track ratings
  ratedAt   DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  albumId String
  album   Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)

  comment Comment?

  @@unique([userId, albumId])
  @@index([albumId])
  @@index([userId])
}

model TrackRating {
  id        String   @id @default(cuid())
  score     Int? // 0–100, user-selected
  ratedAt   DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  trackId String
  track   Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)

  comment Comment?

  @@unique([userId, trackId])
  @@index([trackId])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // edited alongside the rating

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  ratingId String? @unique
  rating   Rating? @relation(fields: [ratingId], references: [id], onDelete: Cascade)

  trackRatingId String?      @unique
  trackRating   TrackRating? @relation(fields: [trackRatingId], references: [id], onDelete: Cascade)

  // Notifications generated by this comment (e.g. "new comment" pings to
  // the rating's owner). Cascades — deleting the comment clears them too.
  notifications Notification[]
}

// ──────────────────────────────
// Streaming links (shared: album or artist)
// ──────────────────────────────

model StreamingLink {
  id       String            @id @default(cuid())
  platform StreamingPlatform
  url      String

  albumId String?
  album   Album?  @relation(fields: [albumId], references: [id], onDelete: Cascade)

  artistId String?
  artist   Artist? @relation(fields: [artistId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([albumId])
  @@index([artistId])
}

// ──────────────────────────────
// Rotations (weekly rating cycles)
// ──────────────────────────────

model Rotation {
  id         String   @id @default(cuid())
  name       String
  slug       String?  @unique
  coverImage String?
  startDate  DateTime
  endDate    DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  albums RotationAlbum[]

  notifications Notification[]

  // Users whose streak-tracking currently points at this rotation as
  // their most recently completed one.
  usersCompletedHere User[]
}

model RotationAlbum {
  id         String   @id @default(cuid())
  rotationId String
  albumId    String
  rotation   Rotation @relation(fields: [rotationId], references: [id], onDelete: Cascade)
  album      Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)

  // Snapshot only: write Album.averageRating/ratingCount into these once,
  // at closedAt. Not a live aggregate — do not keep in sync afterward.
  averageRating Float?
  ratingCount   Int       @default(0)
  closedAt      DateTime?

  @@unique([rotationId, albumId])
  @@index([albumId])
}

// ──────────────────────────────
// Genres
// ──────────────────────────────

model Genre {
  id       String  @id @default(cuid())
  name     String  @unique
  slug     String  @unique
  parentId String?

  parent   Genre?  @relation("GenreHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Genre[] @relation("GenreHierarchy")

  albums  AlbumGenre[]
  artists ArtistGenre[]

  @@index([parentId])
}

model AlbumGenre {
  albumId String
  genreId String

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([albumId, genreId])
  @@index([genreId])
}

model ArtistGenre {
  artistId String
  genreId  String

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  genre  Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([artistId, genreId])
  @@index([genreId])
}

// ──────────────────────────────
// Social graph
// ──────────────────────────────

model Follow {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  followerId String
  follower   User   @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)

  followingId String
  following   User   @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// ──────────────────────────────
// Notifications
// ──────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  // Recipient — the user this notification is for.
  userId String
  user   User   @relation("NotificationsReceived", fields: [userId], references: [id], onDelete: Cascade)

  // Who triggered it. Null for system-generated ones (rotation events)
  // that aren't caused by another user's action.
  actorId String?
  actor   User?   @relation("NotificationsSent", fields: [actorId], references: [id], onDelete: SetNull)

  // Optional targets — which of these is set depends on `type`.
  albumId String?
  album   Album?  @relation(fields: [albumId], references: [id], onDelete: Cascade)

  rotationId String?
  rotation   Rotation? @relation(fields: [rotationId], references: [id], onDelete: Cascade)

  commentId String?
  comment   Comment?  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}
