generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  name      String?
  image     String?
  createdAt DateTime @default(now())

  ratings      Rating[]
  trackRatings TrackRating[]
  comments     Comment[]
}

model Artist {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  image String?

  albums AlbumArtist[]
}

model Album {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  coverImage  String?
  releaseYear Int?
  genre       String?
  createdAt   DateTime @default(now())

  artists     AlbumArtist[]
  tracks      Track[]
  ratings     Rating[]
  socialLinks AlbumSocialLink[]
}

model Track {
  id        String   @id @default(cuid())
  title     String
  number    Int?
  createdAt DateTime @default(now())

  albumId String
  album   Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  ratings TrackRating[]

  @@index([albumId])
}

// Explicit join table for the many-to-many Artist <-> Album relation
model AlbumArtist {
  album    Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  albumId  String
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  artistId String

  @@id([albumId, artistId])
}

model Rating {
  id        String   @id @default(cuid())
  score     Int?     // user's grade for the album
  finalized Boolean  @default(false) // open for rating vs closed/finalized
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  albumId String
  album   Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)

  comments Comment[]

  @@unique([userId, albumId])
}

model TrackRating {
  id        String   @id @default(cuid())
  score     Int?     // user's grade for this track
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  trackId String
  track   Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  ratingId String
  rating   Rating @relation(fields: [ratingId], references: [id], onDelete: Cascade)
}

model AlbumSocialLink {
  id        String   @id @default(cuid())
  platform  String
  url       String
  createdAt DateTime @default(now())

  albumId String
  album   Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId])
}