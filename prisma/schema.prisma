
generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  emailVerified   Boolean  @default(false)
  username        String   @unique
  displayUsername String?
  name            String?
  image           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Auth related
  role       String    @default("user")
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?
  sessions   Session[]
  accounts   Account[]

  // User album, track and comments.
  ratings      Rating[]
  trackRatings TrackRating[]
  comments     Comment[]

  @@map("user")
}

model Session {
  id             String   @id @default(cuid())
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
  @@index([identifier])
}

model Artist {
  id    String  @id @default(cuid())
  name  String
  slug  String  @unique
  image String?

  albums AlbumArtist[]
}

model Album {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  coverImage  String?
  releaseDate DateTime?
  genre       String?
  finalized   Boolean   @default(false) // false = open for ratings, true = closed/finalized
  createdAt   DateTime  @default(now())

  artists     AlbumArtist[]
  tracks      Track[]
  ratings     Rating[]
  socialLinks AlbumSocialLink[]
}

model Track {
  id        String   @id @default(cuid())
  title     String
  number    Int?
  createdAt DateTime @default(now())

  albumId String
  album   Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)

  ratings TrackRating[]

  @@index([albumId])
}

// Explicit join table for the many-to-many Artist <-> Album relation

model AlbumArtist {
  album    Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  albumId  String
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  artistId String

  @@id([albumId, artistId])
}

model Rating {
  id        String   @id @default(cuid())
  score     Int?
  ratedAt   DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  albumId String
  album   Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)

  comment Comment?

  @@unique([userId, albumId])
}

model TrackRating {
  id        String   @id @default(cuid())
  score     Int?
  ratedAt   DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  trackId String
  track   Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)

  comment Comment?

  @@unique([userId, trackId])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  ratingId String? @unique
  rating   Rating? @relation(fields: [ratingId], references: [id], onDelete: Cascade)

  trackRatingId String?      @unique
  trackRating   TrackRating? @relation(fields: [trackRatingId], references: [id], onDelete: Cascade)
}

model AlbumSocialLink {
  id        String   @id @default(cuid())
  platform  String
  url       String
  createdAt DateTime @default(now())

  albumId String
  album   Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId])
}
